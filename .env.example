# Variáveis de ambiente do EduSpace.
# Copie para .env e ajuste. Nunca versione o .env.
# Cada aplicação terá o próprio .env.example com o seu bloco (issues #10 e #11).

# ---------------------------------------------------------------
# Docker Compose: PostgreSQL local (raiz do repositório)
# ---------------------------------------------------------------
POSTGRES_USER=eduspace
POSTGRES_PASSWORD=eduspace_dev
POSTGRES_DB=eduspace
POSTGRES_TEST_DB=eduspace_test
POSTGRES_PORT=5433

# ---------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://eduspace:eduspace_dev@localhost:5433/eduspace
TEST_DATABASE_URL=postgresql+psycopg://eduspace:eduspace_dev@localhost:5433/eduspace_test

# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_EXPIRES_MINUTES=480

# Cadastro: vazio = qualquer e-mail. Para exigir e-mail institucional: ALLOWED_EMAIL_DOMAINS=umj.edu.br
ALLOWED_EMAIL_DOMAINS=

# Origens do frontend autorizadas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Admin inicial criado por `make seed` (senha com letras e números, 8+ caracteres)
SEED_ADMIN_NOME=Administrador EduSpace
SEED_ADMIN_EMAIL=admin@umj.edu.br
SEED_ADMIN_SENHA=

# Senha das contas de demonstração (`make seed-demo`, apresentação #38): aluno.demo, prof.demo e
# admin.demo @umj.edu.br. O seed refaz as reservas de demonstração relativas a hoje.
SEED_DEMO_SENHA=
# true: a inicialização da API (scripts/start.sh) roda o seed de demonstração a cada subida
SEED_DEMO=false

# Fuso usado para exibir horários e montar a grade do dia
TZ_EXIBICAO=America/Maceio
# Dias sem faixa ficam fechados. Ex.: seg-sex 08:00-21:00; sab 08:00-12:00
HORARIO_FUNCIONAMENTO=seg-sex 08:00-21:00; sab 08:00-12:00

# Regras de uso. Administrador não tem limite de reservas ativas.
RESERVA_DURACAO_MAX_MIN=240
RESERVA_ANTECEDENCIA_MAX_DIAS=14
RESERVAS_ATIVAS_MAX_ALUNO=3
RESERVAS_ATIVAS_MAX_PROFESSOR=10

# Check-in por QR Code (#43). Sem check-in até CHECKIN_TOLERANCIA_MIN minutos após o início, a
# reserva vira NAO_COMPARECEU e o horário é liberado. 0 desliga o check-in obrigatório e a liberação.
CHECKIN_TOLERANCIA_MIN=15
# A janela de check-in abre este tanto antes do início da reserva
CHECKIN_ANTECEDENCIA_MIN=15

# Regras de reserva (issue #28)
RESERVA_DURACAO_MAX_MIN=240
RESERVA_ANTECEDENCIA_MAX_DIAS=14
RESERVA_CANCELAMENTO_MIN_ANTES=30
RESERVA_LIMITE_ATIVAS_ALUNO=3
RESERVA_LIMITE_ATIVAS_PROFESSOR=10

# ---------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1

# Google Analytics 4 (issue #49). Vazio = analytics desligado
VITE_GA_MEASUREMENT_ID=
